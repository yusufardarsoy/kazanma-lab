APP_ENV=development
APP_USERNAME=arda
# Production'da APP_PASSWORD yerine APP_PASSWORD_HASH kullan.
APP_PASSWORD=kazanma-lab
APP_PASSWORD_HASH=
KAZANMA_DB_PATH=data/kazanma.sqlite

# API-Football (API-Sports) - opsiyonel canlı veri bağlantısı
FOOTBALL_API_KEY=
FOOTBALL_API_BASE=https://v3.football.api-sports.io
FOOTBALL_LEAGUE_ID=203
FOOTBALL_SEASON=2026
FOOTBALL_TIMEZONE=Europe/Istanbul
# Tek eşitlemede fikstür çağrısından sonra en fazla kaç ayrıntı isteği yapılacağı.
# Ücretsiz plandaki 10 istek/dakika sınırının altında kalmak için 8 önerilir.
KAZANMA_SYNC_DETAIL_BUDGET=8

# Football-Data.co.uk: anahtar gerekmez; sezon sonuçları, fikstür ve piyasa
# ortalaması oranları için resmî CSV adresleri. Normalde değiştirme.
FOOTBALL_DATA_SEASON_URL=https://www.football-data.co.uk/mmz4281/2627/T1.csv
FOOTBALL_DATA_FIXTURES_URL=https://www.football-data.co.uk/fixtures.csv
PUBLIC_DATA_REFRESH_HOURS=6

# The Odds API: opsiyonel. Ücretsiz hesap 500 kredi/ay verir.
# Anahtar yoksa Football-Data.co.uk ile ücretsiz senkronizasyon devam eder.
ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com/v4
ODDS_API_REGIONS=eu
ODDS_API_MARKETS=h2h,totals
# 8 saatlik fren, en kötü durumda ücretsiz aylık kotanın altında kalır.
ODDS_API_REFRESH_HOURS=8
